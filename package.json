{
  "name": "claude-code-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gate": "node scripts/gate.mjs",
    "review": "bash .claude/scripts/local-review.sh",
    "capture": "node scripts/capture.mjs",
    "design:capture": "node scripts/design-capture.mjs",
    "evidence": "node .claude/scripts/upload-evidence.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "globals": "16.4.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
